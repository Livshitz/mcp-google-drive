{
  "name": "@livx.cc/mcp-google-drive",
  "version": "0.3.0",
  "description": "Google Drive and Sheets MCP server and reusable library",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
